<Application x:Class="EyePeeOnMyTV.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0D" />
        <SolidColorBrush x:Key="AppForegroundBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#3D8BFD" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1A1A1D" />
        <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#26262B" />
        <SolidColorBrush x:Key="AppMutedBrush" Color="#9A9AA2" />

        <!--
            User-configurable accent color (Settings > Accent Color). Distinct from AppAccentBrush
            above, which is the app's own fixed blue used for buttons. This one starts at Search's
            original hardcoded green and is swapped for a new SolidColorBrush at runtime (see
            MainWindow.ApplyAccentColor) whenever settings load or the user picks a new color —
            consumed via DynamicResource (not StaticResource) so it updates live.
        -->
        <SolidColorBrush x:Key="UserAccentBrush" Color="#39FF14" />

        <!--
            WPF's default Menu/MenuItem theme (and standard dialog chrome like GroupBox/ComboBox)
            pulls its colors from these SystemColors resource keys. Overriding them app-wide is far
            less code than re-templating every Menu/MenuItem/Popup by hand, and keeps the menu bar
            and all the new tool windows consistent with the app's dark theme.
        -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#1A1A1D" />
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1A1A1D" />
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F2F2F2" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1A1D" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F2F2" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#26262B" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#000000" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0B0B0D" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F2F2" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3D8BFD" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6B6B72" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#33333A" />

        <SolidColorBrush x:Key="AppBorderBrush" Color="#33333A" />

        <!--
            The SystemColors overrides above don't reliably reach the MenuItem submenu Popup on
            every WPF theme (it rendered with a blank white background in testing), so the menu
            bar gets an explicit dark template instead — the more reliable fix for this control.
        -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,4" />
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="10,6">
                                    <Grid>
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                                <StackPanel IsItemsHost="True" Margin="2" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppSurfaceHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="10,6">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppSurfaceHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="4,6" MinWidth="180">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                           VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="2" Text="▶" FontSize="9" Margin="16,0,6,0"
                                                    VerticalAlignment="Center" Foreground="{StaticResource AppMutedBrush}" />
                                        <Popup x:Name="Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" HorizontalOffset="-2">
                                            <Border Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                                                <StackPanel IsItemsHost="True" Margin="2" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppSurfaceHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="4,6" MinWidth="180">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CheckGlyph" Grid.Column="0" Text="✓" Visibility="Collapsed"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppAccentBrush}" FontWeight="Bold" />
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                           VerticalAlignment="Center" Margin="4,0" />
                                        <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                                   Foreground="{StaticResource AppMutedBrush}" Margin="16,0,6,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppSurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
