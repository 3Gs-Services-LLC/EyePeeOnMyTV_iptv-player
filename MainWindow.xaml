<Window x:Class="EyePeeOnMyTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="EyePeeOnMyTV"
        Width="1280" Height="720"
        MinWidth="640" MinHeight="400"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource AppForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppSurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppSurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Black">

        <!--
            LibVLCSharp.WPF's VideoView renders through a detached native window, which always
            paints above ordinary WPF-composited siblings (the WPF "airspace" limitation). Per
            LibVLCSharp.WPF's own guidance, all overlay content must live INSIDE VideoView.Content
            instead of as siblings, or it never becomes visible over the video.
        -->
        <vlc:VideoView x:Name="VideoViewControl">
            <!--
                The overlay content above is hosted by VideoView in its own detached native window
                (see the comment above), so mouse input over it never bubbles to the outer Window's
                MouseMove — it has to be wired directly on this Grid instead. Background="Transparent"
                is required too: a null Background makes empty Grid area non-hit-testable in WPF, so
                without it, movement over the video (i.e. everywhere without a control) would be silently
                dropped even here.
            -->
            <DockPanel Background="Transparent" MouseMove="Window_MouseMove">

                <Menu x:Name="AppMenuBar" DockPanel.Dock="Top" Background="{StaticResource AppSurfaceBrush}"
                      Foreground="{StaticResource AppForegroundBrush}">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Open File…" InputGestureText="Ctrl+O" Click="File_OpenFile_Click" />
                        <MenuItem Header="Open _Network Stream…" InputGestureText="Ctrl+N" Click="File_OpenNetworkStream_Click" />
                        <Separator />
                        <MenuItem Header="_Settings…" InputGestureText="Ctrl+," Click="File_Settings_Click" />
                        <Separator />
                        <MenuItem Header="E_xit" InputGestureText="Ctrl+Q" Click="File_Exit_Click" />
                    </MenuItem>
                    <MenuItem Header="_Playback">
                        <MenuItem Header="Play / Pause" InputGestureText="Space" Click="PlayPauseButton_Click" />
                        <MenuItem Header="Stop" InputGestureText="S" Click="Playback_Stop_Click" />
                        <Separator />
                        <MenuItem Header="Jump Backward 10s" InputGestureText="Left" Click="Playback_JumpBackward_Click" />
                        <MenuItem Header="Jump Forward 10s" InputGestureText="Right" Click="Playback_JumpForward_Click" />
                        <MenuItem Header="Next Frame" InputGestureText="E" Click="Playback_NextFrame_Click" />
                        <MenuItem Header="Speed">
                            <MenuItem Header="0.5x" Tag="0.5" Click="Playback_Speed_Click" />
                            <MenuItem Header="0.75x" Tag="0.75" Click="Playback_Speed_Click" />
                            <MenuItem Header="1x (Normal)" Tag="1.0" Click="Playback_Speed_Click" />
                            <MenuItem Header="1.25x" Tag="1.25" Click="Playback_Speed_Click" />
                            <MenuItem Header="1.5x" Tag="1.5" Click="Playback_Speed_Click" />
                            <MenuItem Header="2x" Tag="2.0" Click="Playback_Speed_Click" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Previous Channel" InputGestureText="Down" Click="PreviousButton_Click" />
                        <MenuItem Header="Next Channel" InputGestureText="Up" Click="NextButton_Click" />
                    </MenuItem>
                    <MenuItem Header="_Audio">
                        <MenuItem x:Name="AudioTrackMenu" Header="Track" SubmenuOpened="AudioTrackMenu_SubmenuOpened">
                            <MenuItem Header="(none available)" IsEnabled="False" />
                        </MenuItem>
                        <MenuItem x:Name="AudioOutputDeviceMenu" Header="Output Device" SubmenuOpened="AudioOutputDeviceMenu_SubmenuOpened">
                            <MenuItem Header="(default device)" IsEnabled="False" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Increase Volume" InputGestureText="Ctrl+Up" Click="Audio_VolumeUp_Click" />
                        <MenuItem Header="Decrease Volume" InputGestureText="Ctrl+Down" Click="Audio_VolumeDown_Click" />
                        <MenuItem Header="Mute" InputGestureText="M" Click="MuteButton_Click" />
                        <Separator />
                        <MenuItem Header="Equalizer…" InputGestureText="Ctrl+E" Click="Audio_Equalizer_Click" />
                    </MenuItem>
                    <MenuItem Header="_Video">
                        <MenuItem x:Name="VideoTrackMenu" Header="Track" SubmenuOpened="VideoTrackMenu_SubmenuOpened">
                            <MenuItem Header="(none available)" IsEnabled="False" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Fullscreen" InputGestureText="F11" Click="FullscreenButton_Click" />
                        <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on Top" InputGestureText="Ctrl+T" IsCheckable="True" Click="Video_AlwaysOnTop_Click" />
                        <Separator />
                        <MenuItem Header="Aspect Ratio">
                            <MenuItem Header="Default" Click="Video_AspectRatio_Click" />
                            <MenuItem Header="1:1" Tag="1:1" Click="Video_AspectRatio_Click" />
                            <MenuItem Header="4:3" Tag="4:3" Click="Video_AspectRatio_Click" />
                            <MenuItem Header="16:9" Tag="16:9" Click="Video_AspectRatio_Click" />
                            <MenuItem Header="16:10" Tag="16:10" Click="Video_AspectRatio_Click" />
                            <MenuItem Header="221:100" Tag="221:100" Click="Video_AspectRatio_Click" />
                            <MenuItem Header="5:4" Tag="5:4" Click="Video_AspectRatio_Click" />
                        </MenuItem>
                        <MenuItem Header="Crop">
                            <MenuItem Header="Default" Click="Video_Crop_Click" />
                            <MenuItem Header="1:1" Tag="1:1" Click="Video_Crop_Click" />
                            <MenuItem Header="4:3" Tag="4:3" Click="Video_Crop_Click" />
                            <MenuItem Header="16:9" Tag="16:9" Click="Video_Crop_Click" />
                            <MenuItem Header="16:10" Tag="16:10" Click="Video_Crop_Click" />
                        </MenuItem>
                        <MenuItem Header="Deinterlace">
                            <MenuItem Header="Off" Click="Video_Deinterlace_Click" />
                            <MenuItem Header="Auto" Tag="" Click="Video_Deinterlace_Click" />
                            <MenuItem Header="Blend" Tag="blend" Click="Video_Deinterlace_Click" />
                            <MenuItem Header="Bob" Tag="bob" Click="Video_Deinterlace_Click" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Take Snapshot" InputGestureText="Shift+S" Click="Video_Snapshot_Click" />
                        <MenuItem Header="Video Adjustments…" InputGestureText="Ctrl+J" Click="Video_Adjustments_Click" />
                    </MenuItem>
                    <MenuItem Header="_Subtitle">
                        <MenuItem x:Name="SubtitleTrackMenu" Header="Track" SubmenuOpened="SubtitleTrackMenu_SubmenuOpened">
                            <MenuItem Header="(none available)" IsEnabled="False" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Add Subtitle File…" InputGestureText="Ctrl+Shift+S" Click="Subtitle_AddFile_Click" />
                        <MenuItem Header="Increase Delay" InputGestureText="Ctrl+Shift+Up" Click="Subtitle_DelayIncrease_Click" />
                        <MenuItem Header="Decrease Delay" InputGestureText="Ctrl+Shift+Down" Click="Subtitle_DelayDecrease_Click" />
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="Media Information…" InputGestureText="Ctrl+I" Click="Tools_MediaInfo_Click" />
                        <MenuItem Header="Messages…" InputGestureText="Ctrl+M" Click="Tools_Messages_Click" />
                        <Separator />
                        <MenuItem Header="Channel List" InputGestureText="Ctrl+L" Click="ToggleSidebarButton_Click" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="About EyePeeOnMyTV…" InputGestureText="Ctrl+F1" Click="Help_About_Click" />
                        <MenuItem Header="_Shortcuts…" InputGestureText="F1" Click="Help_Shortcuts_Click" />
                    </MenuItem>
                </Menu>

            <Grid Background="Transparent">

                <!-- Channel name / logo overlay (top-left, unobtrusive) -->
                <Border x:Name="ChannelInfoOverlay" Background="#B0000000" CornerRadius="6"
                        Padding="10,6" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="ChannelLogoImage" Width="28" Height="28" Margin="0,0,8,0"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="ChannelNameText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppForegroundBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Now playing / up next EPG overlay (top-right, auto-hide) -->
                <Border x:Name="EpgOverlay" Background="#B0000000" CornerRadius="6"
                        Padding="12,8" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Visibility="Collapsed" MaxWidth="360">
                    <StackPanel>
                        <TextBlock x:Name="EpgNowText" Text="" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppForegroundBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="EpgNextText" Text="" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource AppMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Reconnecting / error state -->
                <Border x:Name="PlaybackStatusOverlay" Background="#C0000000" CornerRadius="8"
                        Padding="20,14" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="PlaybackStatusText" FontSize="15"
                               Foreground="{StaticResource AppForegroundBrush}" HorizontalAlignment="Center" />
                </Border>

                <!-- Bottom control bar (auto-hide on fullscreen idle) -->
                <Border x:Name="ControlBar" Background="#D0121214" VerticalAlignment="Bottom"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <Button x:Name="SidebarToggleButton" Content="☰" Style="{StaticResource IconButtonStyle}"
                                    Click="ToggleSidebarButton_Click" ToolTip="Channel list (Ctrl+L)" />
                            <Button x:Name="PreviousButton" Content="⏮" Style="{StaticResource IconButtonStyle}"
                                    Click="PreviousButton_Click" ToolTip="Previous channel (Down / PgDn)" />
                            <Button x:Name="PlayPauseButton" Content="⏸" Style="{StaticResource IconButtonStyle}"
                                    Click="PlayPauseButton_Click" ToolTip="Play / Pause (Space)" />
                            <Button x:Name="NextButton" Content="⏭" Style="{StaticResource IconButtonStyle}"
                                    Click="NextButton_Click" ToolTip="Next channel (Up / PgUp)" />
                            <Button x:Name="MuteButton" Content="🔊" Style="{StaticResource IconButtonStyle}"
                                    Click="MuteButton_Click" ToolTip="Mute (M)" />
                            <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" Value="80"
                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                        </StackPanel>

                        <TextBlock x:Name="StatusText" Grid.Column="1" Text=""
                                   Foreground="{StaticResource AppMutedBrush}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" Grid.Column="2">
                            <Button x:Name="FullscreenButton" Content="⛶" Style="{StaticResource IconButtonStyle}"
                                    Click="FullscreenButton_Click" ToolTip="Fullscreen (F / F11)" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Channel list sidebar (collapsible) -->
                <Border x:Name="SidebarPanel" Background="#E01A1A1D" Width="300"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,12" Background="{StaticResource AppSurfaceBrush}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButtonStyle}"
                                        Click="ToggleSidebarButton_Click" />
                                <Button x:Name="ChannelSortButton" DockPanel.Dock="Right" MinWidth="44"
                                        Style="{StaticResource IconButtonStyle}" FontSize="13"
                                        Click="ChannelSortButton_Click" />
                                <TextBlock Text="Channels" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource AppForegroundBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Grid DockPanel.Dock="Top" Margin="10,10,10,4">
                            <TextBox x:Name="ChannelFilterBox"
                                     Padding="8,6" Background="{StaticResource AppSurfaceBrush}"
                                     Foreground="{StaticResource AppForegroundBrush}" BorderThickness="0"
                                     CaretBrush="White"
                                     TextChanged="ChannelFilterBox_TextChanged" />
                            <TextBlock x:Name="ChannelFilterPlaceholder" Text="Search"
                                       Foreground="#39FF14" Margin="12,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <ListBox x:Name="ChannelListBox" Margin="6,4,6,6" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ChannelListItemStyle}"
                                 SelectionChanged="ChannelListBox_SelectionChanged"
                                 PreviewKeyDown="ChannelListBox_PreviewKeyDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Startup loading state (topmost until data is loaded) -->
                <Grid x:Name="LoadingOverlay" Background="{StaticResource AppBackgroundBrush}" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="EyePeeOnMyTV" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AppForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True" Width="220" Height="4" />
                        <TextBlock x:Name="LoadingStatusText" Text="Loading channels and guide…" Margin="0,12,0,0"
                                   Foreground="{StaticResource AppMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
            </DockPanel>
        </vlc:VideoView>
    </Grid>
</Window>
